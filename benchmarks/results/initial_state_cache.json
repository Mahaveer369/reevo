ss` advances.\n      3. Downstream congestion avoidance (`-winq_norm`, Work in Next Queue) and mild SPT tie-breaking (`-pt_norm`).\n    \"\"\"\n    pt = features['pt_norm']\n    mwkr = features['rem_work_norm']\n    mor = features['rem_ops_norm']\n    winq = features['winq_norm']\n    slack = features['slack_norm']\n    es = features['earliest_start_norm']\n    prog = features['progress']\n\n    scores = []\n    for p, m, o, w, s, e in zip(pt, mwkr, mor, winq, slack, es):\n        tail_urgency = 1.60 * m + 0.35 * o - 0.85 * s\n        idle_and_queue_penalty = (0.90 + 0.40 * prog) * e + 0.18 * w + 0.06 * p\n        scores.append(tail_urgency - idle_and_queue_penalty)\n    return scores\n", "benchmark": {"instance_names": ["ft06", "ft10", "ft20", "la01", "la02", "la03", "la04", "la05", "la16", "orb01", "abz5", "abz6"], "n_seeds": 1, "n_starts": 5, "ls_steps": 15, "custom_error": null, "summary_rows": [{"id": "spt_gt", "category": "A. Classical Dispatching", "name": "SPT (Giffler\u2013Thompson Active)", "mean_cmax": 1191.8, "mean_gap": 53.56, "sd_gap": 14.44, "median_gap": 53.39, "best_gap": 53.56, "mean_runtime_ms": 1.2, "mean_evaluations": 1, "code_lines": 2, "vrpagent_fitness": 53.6, "feasibility_rate": 100.0}, {"id": "fifo_gt", "category": "A. Classical Dispatching", "name": "FIFO (Earliest Ready Time)", "mean_cmax": 1015.2, "mean_gap": 28.9, "sd_gap": 16.05, "median_gap": 26.74, "best_gap": 28.9, "mean_runtime_ms": 1.25, "mean_evaluations": 1, "code_lines": 2, "vrpagent_fitness": 28.94, "feasibility_rate": 100.0}, {"id": "mor_gt", "category": "A. Classical Dispatching", "name": "MOR (Most Operations Remaining)", "mean_cmax": 981.8, "mean_gap": 23.11, "sd_gap": 10.68, "median_gap": 19.7, "best_gap": 23.11, "mean_runtime_ms": 1.35, "mean_evaluations": 1, "code_lines": 2, "vrpagent_fitness": 23.15, "feasibility_rate": 100.0}, {"id": "mwkr_gt", "category": "A. Classical Dispatching", "name": "MWKR (Most Work Remaining)", "mean_cmax": 989.2, "mean_gap": 24.11, "sd_gap"